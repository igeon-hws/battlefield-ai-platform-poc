      "maintenanceStatus": {
        "default": "unknown",
        "enum": [
          "serviceable",
          "maintenance",
          "unknown"
        ],
        "title": "Maintenancestatus",
        "type": "string"
      },
      "observedAt": {
        "anyOf": [
          {
            "maxLength": 64,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Observedat"
      },
      "source": {
        "anyOf": [
          {
            "maxLength": 120,
            "type": "string"
          },
          {
            "type": "null"
          }
