        "title": "Kind",
        "type": "string"
      },
      "Position": {
        "additionalProperties": false,
        "properties": {
          "longitude": {
            "maximum": 180,
            "minimum": -180,
            "title": "Longitude",
            "type": "number"
          },
          "latitude": {
            "maximum": 85,
            "minimum": -85,
            "title": "Latitude",
            "type": "number"
          }
