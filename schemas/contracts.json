          "eastMps": {
            "default": 0,
            "maximum": 200,
            "minimum": -200,
            "title": "Eastmps",
            "type": "number"
          },
          "northMps": {
            "default": 0,
            "maximum": 200,
            "minimum": -200,
            "title": "Northmps",
            "type": "number"
          }
        },
        "title": "Velocity",
        "type": "object"
