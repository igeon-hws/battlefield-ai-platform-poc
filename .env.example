# Configure locally; never commit credentials.
OPENAI_API_KEY=
OPENAI_MODEL=

C4I_PORT=4100
C4I_DB=var/c4i.db
C4I_SCENARIO=border-demo
C4I_BASE_URL=http://127.0.0.1:4100
# Optional local Bearer tokens. Match the source read token across services.
C4I_READ_TOKEN=
C4I_CONTROL_TOKEN=

MCP_PORT=4200
MCP_SERVER_URL=http://127.0.0.1:4200/mcp
MCP_TOKEN=

PLATFORM_PORT=4300
PLATFORM_DB=var/platform.db
# Synthetic source services (separate databases and permissions)
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_TEST_URI=bolt://127.0.0.1:17687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
PLATFORM_VNEXT_DB=var/platform-vnext-v2.db
AUTO_SEMANTIC_MODE=off
AGENT_MAX_ITERATIONS=24
AGENT_MAX_TOOLS=20
AGENT_DEADLINE_SECONDS=120
AGENT_LOG_ENABLED=true
AGENT_LOG_DIR=var/logs/agent
SEMANTIC_BASE_URL=http://127.0.0.1:4400
SEMANTIC_PORT=4400
SEMANTIC_READ_TOKEN=
SEMANTIC_MCP_PORT=4410
SEMANTIC_MCP_URL=http://127.0.0.1:4410/mcp
SEMANTIC_MCP_TOKEN=
BUILDER_PORT=4420
BUILDER_BASE_URL=http://127.0.0.1:4420
# Required for individually launched Builder/Platform; dev --profile full generates a shared ephemeral token when blank.
BUILDER_ADMIN_TOKEN=
ATCIS_PORT=4100
ATCIS_DB=var/atcis-v2.db
ATCIS_BASE_URL=http://127.0.0.1:4100
ATCIS_READ_TOKEN=
ATCIS_CONTROL_TOKEN=
ATCIS_MCP_PORT=4200
ATCIS_MCP_TOKEN=
KNCCS_PORT=4110
KNCCS_DB=var/knccs-v2.db
KNCCS_BASE_URL=http://127.0.0.1:4110
KNCCS_READ_TOKEN=
KNCCS_CONTROL_TOKEN=
KNCCS_MCP_PORT=4210
KNCCS_MCP_TOKEN=

# V4 launcher defaults: source records only; Fabric owns knowledge documents.
ATCIS_V4_DB=var/atcis-v4.db
KNCCS_V4_DB=var/knccs-v4.db
PLATFORM_V4_DB=var/platform-v4.db
KNOWLEDGE_MCP_PORT=4430
KNOWLEDGE_MCP_URL=http://127.0.0.1:4430/mcp
KNOWLEDGE_MCP_TOKEN=

# V5 launcher defaults: three sources and mode-scoped demo pages.
ATCIS_V5_DB=var/atcis-v5.db
KNCCS_V5_DB=var/knccs-v5.db
PLATFORM_V5_DB=var/platform-v5.db
LOGISTICS_DB=var/logistics-v5.db
LOGISTICS_PORT=4120
LOGISTICS_BASE_URL=http://127.0.0.1:4120
LOGISTICS_READ_TOKEN=
LOGISTICS_CONTROL_TOKEN=
LOGISTICS_MCP_PORT=4220
LOGISTICS_MCP_URL=http://127.0.0.1:4220/mcp
LOGISTICS_MCP_TOKEN=
