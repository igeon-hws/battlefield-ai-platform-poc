# Configure locally; never commit credentials.
OPENAI_API_KEY=
OPENAI_MODEL=

C4I_PORT=4100
C4I_DB=var/c4i.db
C4I_SCENARIO=border-demo
C4I_BASE_URL=http://127.0.0.1:4100
# Optional local Bearer tokens. Match the source read token across services.
C4I_READ_TOKEN=
C4I_CONTROL_TOKEN=

MCP_PORT=4200
MCP_SERVER_URL=http://127.0.0.1:4200/mcp
MCP_TOKEN=

PLATFORM_PORT=4300
PLATFORM_DB=var/platform.db
