   "title": "군수 자산 동일성과 정비·부품·수송 연결",
   "definition": {
    "identity": "assets.externalSystem/externalId within registration validFrom..validTo",
    "reservationIsWorkOrderSpecific": true,
    "incomingRequiresDelivery": true
   },
   "dependsOn": []
