 "rules": [
  {
   "ruleId": "ASSET-TYPE-01",
   "systemId": "atcis",
   "section": "mapping",
   "definition": {
    "typeField": "classCode",
    "values": {
     "TK": "tank",
     "AAV": "armored_vehicle",
     "LOG": "support_vehicle",
     "UAS": "uav"
    }
   },
   "documentKey": "atcis:EX-01",
   "title": "지상 장비 유형 매핑",
   "dependsOn": []
  },
  {
   "ruleId": "ASSET-TYPE-NAVAL-01",
   "systemId": "knccs",
   "section": "mapping",
   "definition": {
    "typeField": "hullClass",
    "values": {
     "FF": "naval_vessel",
     "LP": "naval_vessel"
    }
   },
   "documentKey": "knccs:EX-01",
   "title": "해상 함정 유형 매핑",
   "dependsOn": []
  },
  {
   "ruleId": "AVAIL-LAND-01",
   "systemId": "atcis",
   "section": "mapping",
   "definition": {
    "cases": [
     {
      "field": "maintenanceCode",
      "op": "EQ",
      "value": "FMC",
      "result": "available"
     },
     {
      "field": "maintenanceCode",
      "op": "EQ",
      "value": "PMC",
      "result": "limited"
     },
     {
      "field": "maintenanceCode",
      "op": "EQ",
      "value": "NMC",
      "result": "unavailable"
     }
    ],
    "default": "unknown"
   },
   "documentKey": "atcis:EX-01",
   "title": "지상 장비 가용 상태 판정",
   "dependsOn": []
  },
  {
   "ruleId": "AVAIL-NAVAL-01",
   "systemId": "knccs",
   "section": "mapping",
   "definition": {
    "cases": [
     {
      "op": "OR",
      "args": [
       {
        "field": "engineering",
        "op": "EQ",
        "value": "DOWN"
       },
       {
        "field": "mission",
        "op": "EQ",
        "value": "HOLD"
       }
      ],
      "result": "unavailable"
     },
     {
      "op": "AND",
      "args": [
       {
        "field": "engineering",
        "op": "EQ",
        "value": "UP"
       },
       {
        "field": "mission",
        "op": "EQ",
        "value": "GO"
       }
      ],
      "result": "available"
     }
    ],
    "default": "unknown"
   },
   "documentKey": "knccs:EX-01",
   "title": "해상 함정 가용 상태 판정",
   "dependsOn": []
  },
  {
   "ruleId": "FORCE-SCOPE-01",
   "systemId": "atcis",
   "section": "mapping",
   "definition": {
    "includedRoles": [
     "ORG",
     "ATT",
     "SUP",
     "ASSIGNED",
     "SUPPORT"
    ],
    "supportRoles": [
     "SUP",
     "SUPPORT"
    ],
    "excludedRoles": [
     "CTRL",
     "RECEIVER"
    ],
    "maxDepth": 8
   },
   "documentKey": "atcis:EX-01",
   "title": "부대 범위와 배정 역할",
   "dependsOn": [
    "ORG-ROLE-01"
   ]
  },
  {
   "ruleId": "AGGREGATION-POLICY-01",
   "systemId": "atcis",
   "section": "mapping",
   "definition": {
    "P1": [
     "available"
    ],
    "P2": [
     "available",
     "limited"
    ],
    "unit": "unique_registered_asset",
    "deduplication": "verified_canonical_reference",
    "defaultAvailablePolicy": "P1"
   },
   "documentKey": "atcis:EX-01",
   "title": "가용 전력 집계 정책",
   "dependsOn": [
    "AVAIL-LAND-01",
    "AVAIL-NAVAL-01",
    "FORCE-SCOPE-01"
   ]
  },
  {
