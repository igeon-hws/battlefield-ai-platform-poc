   "title": "편성 관계 구분",
   "dependsOn": []
  },
  {
   "ruleId": "REPORT-LINEAGE-01",
   "systemId": "atcis",
   "section": "incident",
   "definition": {
    "relayIsIndependentObservation": false,
    "ackIsCompletion": false
   },
   "documentKey": "atcis:SOP-01",
   "title": "보고 계보(전달·재전송)",
   "dependsOn": []
  },
  {
   "ruleId": "REPORT-REVISION-01",
   "systemId": "atcis",
   "section": "incident",
   "definition": {
    "method": "explicit_supersedes",
    "timeField": "knownAt"
   },
   "documentKey": "atcis:SOP-01",
   "title": "보고 정정",
   "dependsOn": [
    "REPORT-LINEAGE-01"
   ]
  },
  {
   "ruleId": "ACTIVITY-STEP-01",
   "systemId": "atcis",
   "section": "incident",
   "definition": {
    "steps": [
     "SITE_CHECK",
     "IDENTIFICATION",
     "REVIEW"
    ],
    "condition": {
     "op": "AND",
     "args": [
      {
       "field": "state",
       "op": "EQ",
       "value": "DONE"
      },
      {
       "field": "evidenceReport",
       "op": "EXISTS"
      }
     ]
    },
    "closure": "all_steps_have_completion_evidence"
   },
   "documentKey": "atcis:SOP-01",
   "title": "사고 처리 절차 단계",
   "dependsOn": []
