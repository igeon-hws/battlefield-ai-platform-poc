 "businessQueries": [
  {
   "queryId": "asset-availability-summary",
   "operator": "asset_status_summary",
   "title": "부대 범위 자산 가용 현황",
   "description": "부대(예하 포함) 범위의 고유 등록 자산을 유형·가용 상태별로 집계하고, 기본 가용 집계 기준(AGGREGATION-POLICY-01.defaultAvailablePolicy)으로 가용 수를 산출한다. 공동지원 자산은 검증된 동일성으로 한 번만 센다. 상태 미상은 0이나 가용으로 바꾸지 않는다.",
   "params": {
    "unit": {
     "type": "string",
     "required": true,
     "description": "부대 코드 또는 명칭(현 명칭/이전 명칭)"
    },
    "kind": {
     "type": "string",
     "required": false,
     "description": "tank|armored_vehicle|support_vehicle|uav|naval_vessel"
    }
   },
   "rules": [
    "FORCE-SCOPE-01",
    "ORG-ROLE-01",
    "ASSET-TYPE-01",
    "ASSET-TYPE-NAVAL-01",
    "AVAIL-LAND-01",
    "AVAIL-NAVAL-01",
    "AGGREGATION-POLICY-01"
   ],
   "relations": [
    "SUBORDINATE_TO",
    "ASSIGNED_TO"
   ],
   "examples": [
    {
     "unit": "D1",
     "kind": "tank"
    },
    {
     "unit": "D1"
    },
    {
     "unit": "F1"
    }
   ]
  },
  {
   "queryId": "asset-maintenance-chain",
   "operator": "asset_dependency_chain",
   "title": "자산 정비·부품·수송 의존 체인",
   "description": "장비/함정/군수 자산 하나에서 등록 동일성(SAME_AS)→정비 작업→필요 부품→재고·예약→보급 요청→화물→수송까지 검증된 연결과 고정 시점 원천 기록을 함께 반환한다. 예약은 해당 작업 전용이며 도착 예정만으로 복구 완료를 확정하지 않는다.",
   "params": {
    "systemId": {
     "type": "string",
     "required": true,
     "description": "atcis|knccs|logistics"
    },
    "nativeId": {
     "type": "string",
     "required": true,
     "description": "원천 식별자(예: L-T02, EQ-781)"
    }
   },
   "rules": [
    "LOG-LINK-01"
   ],
   "relations": [
    "SAME_AS",
    "MAINTAINS",
    "REQUIRES",
    "STOCK_OF",
    "RESERVES",
    "FOR_WORK",
    "FULFILLED_BY",
    "CARRIED_BY"
   ],
   "examples": [
    {
     "systemId": "atcis",
     "nativeId": "L-T02"
    }
   ]
  },
  {
   "queryId": "part-supply-status",
   "operator": "part_supply_status",
   "title": "부품 수급 구분",
   "description": "부품 하나의 창고별 보유·예약·비예약 수량, 작업별 예약 귀속, 입고 의존(보급 요청·화물·수송)을 구분해 반환한다. 다른 작업의 예약을 중복 배정하지 않는다.",
   "params": {
    "partId": {
     "type": "string",
     "required": true,
     "description": "부품 ID(예: P-08)"
    }
   },
   "rules": [
    "LOG-LINK-01"
   ],
   "relations": [
    "STOCK_OF",
